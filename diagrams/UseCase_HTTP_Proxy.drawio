        </mxCell>
        <mxCell id="web" value="«внешняя система»&lt;br&gt;Веб-сервер" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="1170" y="370" width="30" height="60" as="geometry" />
        </mxCell>

        
        <mxCell id="uc1" value="Отправить HTTP-запрос через прокси" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
